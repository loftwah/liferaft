{
  "name": "liferaft-loftwah",
  "compatibility_date": "2026-11-12",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "liferaft.loftwah.com", "custom_domain": true }],
  "main": "worker.mjs",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
