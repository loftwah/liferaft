{
  "name": "liferaft",
  "version": "0.3.1",
  "private": true,
  "productName": "Liferaft",
  "description": "Local, read-only desktop app for indexing and recovering messages and attachments from large MBOX archives.",
  "type": "module",
  "author": "OpenAI Codex",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loftwah/liferaft.git"
  },
  "scripts": {
    "build:engine": "bun build src/native/engine.ts --target=node --packages=external --outfile=out/native/engine.mjs",
    "build": "bun run build:engine && cd native && cargo build --locked",
    "dev": "bun run build && native/target/debug/liferaft",
    "dist": "bash scripts/package-macos.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test tests/*.test.ts",
    "test:integration": "bun run build:engine && node --import tsx --test tests/integration/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "bun run format:check && bun run test && bun run test:integration && bun run typecheck"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "better-sqlite3": "13.1.1",
    "html-to-text": "10.0.1",
    "mailparser": "3.14.3",
    "mime-types": "3.0.2",
    "sanitize-filename": "1.6.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/mime-types": "3.0.1",
    "bun-types": "1.4.4",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=24.15.0 <25",
    "bun": ">=1.4.4 <2"
  },
  "homepage": "https://liferaft.loftwah.com/"
}
